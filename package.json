{
  "name": "whirm-backend",
  "version": "0.1.0",
  "description": "Socle API du projet whirm-backend",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "2.0.6",
    "@hono/zod-openapi": "1.4.0",
    "@scalar/hono-api-reference": "0.11.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.27",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "jiti": "2.7.0",
    "prettier": "3.9.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.28.5"
}
